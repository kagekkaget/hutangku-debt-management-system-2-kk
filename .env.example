# Salin file ini ke .env lalu isi nilai sebenarnya.
# Untuk Neon: salin connection string dari dashboard Neon (tab "Connection string").
DATABASE_URL=postgresql://user:password@ep-host-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require

# Rahasia sesi (string acak, minimal 32 karakter)
AUTH_SECRET=ubah-dengan-string-acak

# Opsional: WA Gateway untuk pengingat WhatsApp otomatis
# WA_GATEWAY_URL=https://wa.example-gateway.id
# WA_GATEWAY_TOKEN=token-rahasia
